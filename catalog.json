{
  "name": "tj-agents",
  "description": "Shared base, Agent Store, machine, workflow, engineering, C++, .NET, React, Neovim, Rust, Python, GitHub Actions, and Azure agent capabilities, plus Template for building plugin repositories.",
  "owner": "Tommy Seery",
  "plugins": [
    { "name": "base", "repository": "core" },
    { "name": "agent-store", "repository": "core" },
    { "name": "machine", "repository": "core", "requires": ["base", "agent-store"] },
    { "name": "workflow", "repository": "core", "requires": ["base", "agent-store", "machine"] },
    { "name": "engineering", "repository": "core", "requires": ["base", "workflow", "agent-store", "machine"] },
    { "name": "cpp", "repository": "cpp" },
    { "name": "gpp", "repository": "cpp", "requires": ["cpp"] },
    { "name": "msvc", "repository": "cpp", "requires": ["cpp"] },
    { "name": "win32", "repository": "cpp", "requires": ["cpp"] },
    { "name": "dotnet", "repository": "dotnet" },
    { "name": "efcore", "repository": "dotnet", "requires": ["dotnet"] },
    { "name": "react", "repository": "react" },
    { "name": "nvim", "repository": "nvim" },
    { "name": "rust", "repository": "rust" },
    { "name": "python", "repository": "python" },
    { "name": "github-actions", "repository": "github-actions" },
    { "name": "azure", "repository": "azure" },
    { "name": "template", "repository": "template" },
    { "name": "personal", "repository": "personal", "requires": ["engineering", "machine"] },
    { "name": "work", "repository": "work", "requires": ["base"] },
    { "name": "infonetica", "repository": "infonetica", "requires": ["work", "base", "engineering"] }
  ]
}
